# Postgres container settings (used by docker-compose.yml to init the DB)
POSTGRES_USER=changeme_user
POSTGRES_PASSWORD=changeme_password
POSTGRES_DB=setu_swasthya

# Full connection string used by the host-side FastAPI app and Alembic.
# Must match the POSTGRES_* values above. Uses psycopg v3 (see requirements.txt),
# hence the "+psycopg" dialect — plain "postgresql://" will fail (no psycopg2 installed).
# Host app connects to the container via localhost, since Postgres runs in Docker
# with its port published to the host.
DATABASE_URL=postgresql+psycopg://changeme_user:changeme_password@localhost:5432/setu_swasthya

# --- Day 1 RBAC / identity additions (see backend/docs/Day1.md Appendix B) ---

ENVIRONMENT=development

# JWT (RS256) — generate with:
#   openssl genrsa -out backend/secrets/jwt_private.pem 2048
#   openssl rsa -in backend/secrets/jwt_private.pem -pubout -out backend/secrets/jwt_public.pem
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ALGORITHM=RS256
JWT_ISSUER=setu-swasthya
JWT_AUDIENCE=setu-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Field encryption — generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
BLIND_INDEX_KEY=CHANGE_ME_DIFFERENT_64_HEX_CHARS

# Invitations
INVITE_TOKEN_TTL_HOURS=72
INVITE_MAX_ATTEMPTS=5

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_PER_HOUR=5

# Lockout
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
SUSPEND_AFTER_FAILURES=10

# Superuser
SUPERUSER_ACCESS_TOKEN_MINUTES=5
SUPERUSER_MAX_ACCOUNTS=4
SUPERUSER_IP_ALLOWLIST=

# External
HPR_VERIFY_URL=
SMS_GATEWAY_URL=
DPO_NOTIFICATION_EMAIL=

# Triage engine selection (app/services/triage/factory.py):
#   auto     probe SD's rule engine readiness; use it if ready, else fall
#            back to the deterministic fallback engine
#   rule     force the rule engine; raises at startup if it's not ready
#   fallback force the deterministic fallback engine, no probe run
#
# DEPLOYMENT-HARDENING TASK: was `auto` (the old default) -- explicitly
# set to `fallback` here, matching what actually runs today (confirmed
# live: app.services.triage.rules doesn't exist in this repo, so `auto`
# always resolves to `fallback` anyway -- this is a config-only change
# that makes the ALREADY-true behaviour explicit and deterministic
# across restarts, per this task's own reasoning: "On auto the engine
# can change silently between rehearsal and performance." Every demo
# deployment must set this explicitly, never leave it on `auto`.
TRIAGE_ENGINE=fallback

# Escalation engine selection (app/services/escalation/factory.py):
#   auto     probe SD's escalation_for() readiness; use it if ready, else
#            fall back to the deterministic fallback engine
#   rule     force the rule engine; raises at startup if it's not ready
#   fallback force the deterministic fallback engine, no probe run
#
# Same deployment-hardening reasoning as TRIAGE_ENGINE above -- was
# `auto`, now explicit, matching what's actually active today.
ESCALATION_ENGINE=fallback

# --- Deployment hardening (backend/docs -- security headers/CORS/rate
# limits/health task) ---

# CORS -- comma-separated list of exact frontend origins allowed to make
# credentialed cross-origin requests (app/main.py's CORSMiddleware).
# NEVER "*" -- allow_origins=["*"] with allow_credentials=True is both
# rejected by browsers and a genuine vulnerability (any site could ride
# an authenticated user's cookies/session). No real frontend URL is
# documented anywhere else in this repo (checked backend/docs/*.md,
# README.md) -- this placeholder is a local-dev Flutter web debug origin
# only. Replace with the REAL deployed frontend origin(s) before any
# real demo deploy; this must be set by whoever owns that deployment,
# not guessed here.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Git commit SHA of the deployed build, for GET /health's own
# "is this the build we tested?" answer. Set this at build/deploy time
# (e.g. `docker build --build-arg GIT_COMMIT=$(git rev-parse HEAD)` or
# your CI's own commit-SHA env var) -- left unset in local dev, where
# /health reports "unknown" rather than crashing.
GIT_COMMIT=

# app_user DB role (Day1.md SS9.4) — the restricted role migration 0007
# creates, with UPDATE/DELETE revoked on audit_log. Required to run that
# migration; not yet used as the app's own DATABASE_URL (see that
# migration's docstring). Generate a real local dev value with:
#   openssl rand -base64 24
APP_USER_PASSWORD=CHANGE_ME_APP_USER_DB_PASSWORD
