# Postgres container settings (used by docker-compose.yml to init the DB)
POSTGRES_USER=changeme_user
POSTGRES_PASSWORD=changeme_password
POSTGRES_DB=setu_swasthya

# Full connection string used by the host-side FastAPI app and Alembic.
# Must match the POSTGRES_* values above. Uses psycopg v3 (see requirements.txt),
# hence the "+psycopg" dialect — plain "postgresql://" will fail (no psycopg2 installed).
# Host app connects to the container via localhost, since Postgres runs in Docker
# with its port published to the host.
DATABASE_URL=postgresql+psycopg://changeme_user:changeme_password@localhost:5432/setu_swasthya

# --- Day 1 RBAC / identity additions (see backend/docs/Day1.md Appendix B) ---

ENVIRONMENT=development

# JWT (RS256) — generate with:
#   openssl genrsa -out backend/secrets/jwt_private.pem 2048
#   openssl rsa -in backend/secrets/jwt_private.pem -pubout -out backend/secrets/jwt_public.pem
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ALGORITHM=RS256
JWT_ISSUER=setu-swasthya
JWT_AUDIENCE=setu-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Field encryption — generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
BLIND_INDEX_KEY=CHANGE_ME_DIFFERENT_64_HEX_CHARS

# Invitations
INVITE_TOKEN_TTL_HOURS=72
INVITE_MAX_ATTEMPTS=5

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_PER_HOUR=5

# Lockout
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
SUSPEND_AFTER_FAILURES=10

# Superuser
SUPERUSER_ACCESS_TOKEN_MINUTES=5
SUPERUSER_MAX_ACCOUNTS=4
SUPERUSER_IP_ALLOWLIST=

# External
HPR_VERIFY_URL=
SMS_GATEWAY_URL=
DPO_NOTIFICATION_EMAIL=

# Triage engine selection (app/services/triage/factory.py):
#   auto     (default) probe SD's rule engine readiness; use it if ready,
#            else fall back to the deterministic fallback engine
#   rule     force the rule engine; raises at startup if it's not ready
#   fallback force the deterministic fallback engine, no probe run
TRIAGE_ENGINE=auto

# app_user DB role (Day1.md SS9.4) — the restricted role migration 0007
# creates, with UPDATE/DELETE revoked on audit_log. Required to run that
# migration; not yet used as the app's own DATABASE_URL (see that
# migration's docstring). Generate a real local dev value with:
#   openssl rand -base64 24
APP_USER_PASSWORD=CHANGE_ME_APP_USER_DB_PASSWORD
